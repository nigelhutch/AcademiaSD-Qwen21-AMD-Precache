 Reads configuration from pre_cache_settings_qwenimage21.json if present.
 """
 import os
+import sys
+import subprocess
+import tempfile
+
+def contain_windows_workers():
+    # The GUI terminates the supervisor directly. A non-inheritable Job handle
+    # closes when the supervisor dies, killing all descendants in the Job.
+    if os.name != "nt":
+        raise RuntimeError("Isolated pre-cache is currently Windows-only")
+    import ctypes as C
+    from ctypes import wintypes as W
+    class Basic(C.Structure):
+        _fields_ = [("PerProcessUserTimeLimit", C.c_int64),
+                    ("PerJobUserTimeLimit", C.c_int64), ("LimitFlags", W.DWORD),
+                    ("MinimumWorkingSetSize", C.c_size_t), ("MaximumWorkingSetSize", C.c_size_t),
+                    ("ActiveProcessLimit", W.DWORD), ("Affinity", C.c_size_t),
+                    ("PriorityClass", W.DWORD), ("SchedulingClass", W.DWORD)]
+    class IO(C.Structure):
+        _fields_ = [(name, C.c_uint64) for name in ("ReadOperationCount", "WriteOperationCount",
+                    "OtherOperationCount", "ReadTransferCount", "WriteTransferCount", "OtherTransferCount")]
+    class Extended(C.Structure):
+        _fields_ = [("BasicLimitInformation", Basic), ("IoInfo", IO),
+                    ("ProcessMemoryLimit", C.c_size_t), ("JobMemoryLimit", C.c_size_t),
+                    ("PeakProcessMemoryUsed", C.c_size_t), ("PeakJobMemoryUsed", C.c_size_t)]
+    k = C.WinDLL("kernel32", use_last_error=True)
+    k.CreateJobObjectW.argtypes = [C.c_void_p, W.LPCWSTR]
+    k.CreateJobObjectW.restype = W.HANDLE
+    k.SetInformationJobObject.argtypes = [W.HANDLE, C.c_int, C.c_void_p, W.DWORD]
+    k.SetInformationJobObject.restype = W.BOOL
+    k.GetCurrentProcess.restype = W.HANDLE
+    k.AssignProcessToJobObject.argtypes = [W.HANDLE, W.HANDLE]
+    k.AssignProcessToJobObject.restype = W.BOOL
+    k.CloseHandle.argtypes = [W.HANDLE]
+    k.CloseHandle.restype = W.BOOL
+    h = k.CreateJobObjectW(None, None)
+    if not h:
+        raise C.WinError(C.get_last_error())
+    limits = Extended()
+    limits.BasicLimitInformation.LimitFlags = 0x2000  # KILL_ON_JOB_CLOSE
+    if not k.SetInformationJobObject(h, 9, C.byref(limits), C.sizeof(limits)):
+        error = C.get_last_error()
+        k.CloseHandle(h)
+        raise C.WinError(error)
+    if not k.AssignProcessToJobObject(h, k.GetCurrentProcess()):
+        error = C.get_last_error()
+        k.CloseHandle(h)
+        raise C.WinError(error)
+    # Deliberately keep this raw handle open until OS process teardown.
+    return h
+
+
+def precache_config_identity():
+    import hashlib
+    path = os.path.abspath(os.environ.get("LORALAB_PRECACHE_CONFIG") or
+                           "settings/pre_cache_settings_qwenimage21.json")
+    try:
+        with open(path, "rb") as f:
+            digest = hashlib.sha256(f.read()).hexdigest()
+    except FileNotFoundError:
+        digest = None
+    return [path, digest]
+
+
+def run_isolated_precache():
+    job_handle = contain_windows_workers()
+    config_identity = precache_config_identity()
+    with tempfile.TemporaryDirectory(prefix="loralab-precache-") as directory:
+        manifest = os.path.join(directory, "jobs.json")
+        for phase in ("text", "vae"):
+            if precache_config_identity() != config_identity:
+                print("[!] Pre-cache settings changed; restart pre-cache", flush=True)
+                return 1
+            command = [sys.executable, "-u", os.path.abspath(__file__),
+                       "--internal-precache-" + phase, manifest]
+            result = subprocess.run(command, check=False)
+            if result.returncode:
+                print(f"[!] {phase} process failed: {result.returncode}", flush=True)
+                return 1
+            if phase == "text" and not os.path.isfile(manifest):
+                print("[!] Text process did not produce a job manifest", flush=True)
+                return 1
+    return 0
+
+if __name__ == "__main__" and sys.argv[1:] == ["--isolate-precache"]:
+    sys.exit(run_isolated_precache())
+
+# Opt-in for the application's existing no-argument launcher.
+if (__name__ == "__main__" and len(sys.argv) == 1
+        and os.environ.get("LORALAB_ISOLATE_PRECACHE") == "1"):
+    sys.exit(run_isolated_precache())
+
